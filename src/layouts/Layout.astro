---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { contact, copy, type Lang, type Page, routes } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'en' ? 'tr' : 'en';
const site = Astro.site ?? new URL('https://www.metinsut.com');
const canonical = new URL(routes[lang][page], site);
const locales: Record<Lang, string> = { tr: 'tr_TR', en: 'en_US' };
const role = t.home.work[0].role;
const shareImage = new URL(`/og-${lang}.png`, site);

// Who the site is about, for search engines (schema.org).
const personId = new URL('/#person', site).href;
const websiteId = new URL('/#website', site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Metin Süt',
      jobTitle: role,
      description: t.home.description,
      url: new URL(routes[lang].home, site).href,
      image: new URL('/favicon/android-chrome-512x512.png', site).href,
      email: `mailto:${contact.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'İstanbul', addressCountry: 'TR' },
      knowsLanguage: ['tr', 'en'],
      sameAs: [contact.github, contact.linkedin]
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Metin Süt',
      url: site.href,
      inLanguage: ['tr', 'en'],
      publisher: { '@id': personId }
    },
    {
      '@type': page === 'hire' ? 'ContactPage' : 'ProfilePage',
      name: title,
      description,
      url: canonical.href,
      inLanguage: lang,
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId }
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Metin Süt" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(routes.en[page], site)} />
    <link rel="alternate" hreflang="tr" href={new URL(routes.tr[page], site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(routes.tr[page], site)} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:site_name" content="Metin Süt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:locale:alternate" content={locales[other]} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Metin Süt, ${role.toLocaleLowerCase(lang)}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#0e1a22" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Every visit opens dark. A switch to light lasts only while this tab is open,
      // so it carries across pages; apply it before first paint so the page doesn't flash.
      try {
        localStorage.removeItem('theme'); // drop the old lasting choice from earlier versions
        if (sessionStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').content = '#edf1ec';
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh bg-paper text-ink font-sans">
    <div class="relative isolate overflow-x-clip">
      <slot name="backdrop" />

      <header
        class="relative mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 pt-6 sm:px-8 sm:pt-8">
        <a
          href={routes[lang].home}
          class="site-mark flex items-center gap-2.5 text-ink no-underline"
          aria-label={page === 'home' ? undefined : `Metin Süt, ${t.nav.home}`}>
          <Mark class="size-7 shrink-0" />
          <span class="stretch-widest text-base font-bold tracking-wide">Metin Süt</span>
        </a>
        <nav class="flex items-center gap-5 text-base">
          {
            page !== 'hire' && (
              <a href={routes[lang].hire} class="font-medium">
                {t.nav.hire}
              </a>
            )
          }
          <a href={routes[other][page]} hreflang={other} lang={other} class="text-ink-soft">
            {t.otherLang}
          </a>
          <button
            type="button"
            class="theme-toggle -m-1.5 grid size-9 cursor-pointer place-items-center rounded-full text-ink-soft transition-colors hover:text-ink"
            aria-label={t.nav.darkTheme}
            aria-pressed="true"
            data-theme-toggle>
            <svg
              class="icon-moon size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true">
              <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
            </svg>
            <svg
              class="icon-sun size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
              ></path>
            </svg>
          </button>
        </nav>
      </header>

      <main class="relative mx-auto max-w-6xl px-4 sm:px-8">
        <slot />
      </main>

      <footer
        class="relative mx-auto flex max-w-6xl flex-wrap gap-x-5 gap-y-1 px-4 pt-20 pb-10 text-base text-ink-soft sm:px-8">
        <span>Metin Süt, {t.footer}</span>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const isDark = () => root.dataset.theme !== 'light';

      const sync = () => toggle?.setAttribute('aria-pressed', String(isDark()));

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const applyTheme = (next: 'light' | 'dark') => {
        root.dataset.theme = next;
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
        if (meta) meta.content = next === 'dark' ? '#0e1a22' : '#edf1ec';
        sync();
      };

      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        try {
          sessionStorage.setItem('theme', next);
        } catch {}
        // Crossfade the colors where the browser supports it; switch instantly otherwise.
        if (document.startViewTransition && !reduceMotion.matches) {
          document.startViewTransition(() => applyTheme(next));
        } else {
          applyTheme(next);
        }
      });

      sync();
    </script>
  </body>
</html>

<style>
  /* Sun in dark mode (switch to light), moon in light mode (switch to dark). */
  .icon-moon {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }

  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }
</style>
