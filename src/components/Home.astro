---
import { contact, copy, type Lang, routes } from '../i18n';
import Layout from '../layouts/Layout.astro';
import ContourField from './ContourField.astro';
import RouteProfile from './RouteProfile.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].home;

const links = [
  { href: contact.github, label: 'github.com/metinsut' },
  { href: contact.linkedin, label: 'linkedin.com/in/metinsut' },
  { href: `mailto:${contact.email}`, label: contact.email }
];
---

<Layout lang={lang} page="home" title={t.title} description={t.description}>
  <ContourField slot="backdrop" class="absolute inset-x-0 top-0 -z-10 h-[40rem] w-full" />

  <!-- The first screen: who I am, then the whole route at a glance. -->
  <div class="pt-12 sm:pt-20">
    <section class="max-w-[46rem]">
      <h1
        class="stretch-wide text-[1.75rem] leading-[1.1] font-semibold tracking-[-0.015em] text-balance sm:text-5xl">
        {t.headline}
      </h1>
      <p class="mt-4 max-w-[40rem] text-base leading-relaxed text-ink-soft sm:mt-6 sm:text-lg">
        {t.intro}
      </p>
    </section>

    <section class="mt-10 sm:mt-14" aria-labelledby="flow">
      <h2 id="flow" class="sr-only">{t.routeTitle}</h2>
      <RouteProfile stages={t.route} />
    </section>
  </div>

  <div
    class="mt-20 grid gap-20 sm:mt-24 lg:grid-cols-[minmax(0,36rem)_minmax(0,30rem)] lg:justify-between lg:gap-x-16">
    <section class="max-w-[36rem]" aria-labelledby="route">
      <h2 id="route" class="stretch-wide text-xl font-semibold">{t.routeTitle}</h2>
      <p class="mt-4">{t.lead}</p>
      <ol class="route mt-8">
        {
          t.route.map((stage) => (
            <li class="relative pb-10 pl-9 last:pb-0">
              <h3 class="stretch-wide font-semibold">{stage.name}</h3>
              <p class="mt-1 text-ink-soft">{stage.body}</p>
              <p class="mt-4 text-base font-medium">
                {t.outcomeLabel}
              </p>
              <ul class="outcomes mt-1.5 space-y-1 text-base text-ink-soft">
                {stage.outcomes.map((item) => (
                  <li class="relative pl-5">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <p class="mt-8">
        <a href={routes[lang].hire} class="font-medium">{copy[lang].nav.hire}.</a>
      </p>
    </section>

    <section class="max-w-[36rem] lg:col-start-2 lg:row-span-2 lg:row-start-1" aria-labelledby="work">
      <h2 id="work" class="stretch-wide text-xl font-semibold">{t.workTitle}</h2>
      <ol class="mt-6">
        {
          t.work.map((job) => (
            <li class="grid grid-cols-[7.5rem_1fr] gap-x-4 border-t border-contour py-3 sm:grid-cols-[9rem_1fr]">
              <span class="stretch-condensed text-ink-soft tabular-nums">{job.years}</span>
              <span>
                {job.role}, <span class="text-ink-soft">{job.place}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="max-w-[36rem]" aria-labelledby="find">
      <h2 id="find" class="stretch-wide text-xl font-semibold">{t.findTitle}</h2>
      <ul class="mt-6 space-y-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<style>
  /* A trail between waypoints, the way a route is drawn on a map. */
  .route > li::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 1.35rem;
    bottom: -0.15rem;
    border-left: 2px dashed var(--contour-index);
  }

  .route > li:last-child::before {
    display: none;
  }

  /* Deliverables hang off each waypoint like ticks on a survey line. */
  .outcomes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.625rem;
    border-top: 1px solid var(--contour-index);
  }

  .route > li::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }
</style>
